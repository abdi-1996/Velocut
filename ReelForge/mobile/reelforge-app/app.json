{
  "expo": {
    "name": "ReelForge",
    "slug": "reelforge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abdi.reelforge",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043a \u0432\u0430\u0448\u0435\u043c\u0443 \u0441\u0435\u0440\u0432\u0435\u0440\u0443 \u043c\u043e\u043d\u0442\u0430\u0436\u0430"
      },
      "buildNumber": "1"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "app.reelforge.mobile"
    },
    "web": {},
    "scheme": "reelforge",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0432\u0438\u0434\u0435\u043e \u0434\u043b\u044f \u043c\u043e\u043d\u0442\u0430\u0436\u0430 \u0440\u0438\u043b\u0441\u0430",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-sharing"
    ]
  }
}
